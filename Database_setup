#!/bin/bash

# Exit immediately if a command exits with a non-zero status
set -e

echo "===== PostgreSQL Installation and Setup Script for Ubuntu 20.04 ====="
echo ""

# Update package lists
echo "Updating package lists..."
sudo apt update

# Install PostgreSQL
echo "Installing PostgreSQL and related packages..."
sudo apt install -y postgresql postgresql-contrib

# Check service status
echo "Checking PostgreSQL service status..."
sudo systemctl status postgresql

# Start and enable PostgreSQL service
echo "Ensuring PostgreSQL is running and will start on boot..."
sudo systemctl start postgresql
sudo systemctl enable postgresql

# Create database and setup user permissions
echo "Setting up database and user permissions..."
sudo -u postgres psql <<EOF
-- Create database
CREATE DATABASE db;

-- Create user with password
CREATE USER bill_kaplan WITH PASSWORD 'b1ackjack!';

-- Grant privileges on database
GRANT ALL PRIVILEGES ON DATABASE db TO bill_kaplan;

-- Connect to the new database
\c db

-- Create users table with required schema
CREATE TABLE IF NOT EXISTS users (
    user_id SERIAL PRIMARY KEY,
    username VARCHAR(32) UNIQUE NOT NULL,
    password VARCHAR(32) NOT NULL,
    role VARCHAR(20) CHECK (role IN ('student', 'instructor', 'admin')) NOT NULL
);

-- Grant privileges on all tables to the user
GRANT ALL PRIVILEGES ON ALL TABLES IN SCHEMA public TO bill_kaplan;
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO bill_kaplan;
EOF

# Configure PostgreSQL to allow password authentication
echo "Configuring PostgreSQL authentication methods..."
PG_VERSION=$(psql --version | cut -d " " -f 3 | cut -d "." -f 1)
PG_HBA_CONF="/etc/postgresql/$PG_VERSION/main/pg_hba.conf"

sudo sed -i 's/local\s\+all\s\+all\s\+peer/local all all md5/g' $PG_HBA_CONF

# Optional: Configure PostgreSQL to listen on all interfaces
echo "Configuring PostgreSQL to listen on all interfaces..."
PG_CONF="/etc/postgresql/$PG_VERSION/main/postgresql.conf"
sudo sed -i "s/#listen_addresses = 'localhost'/listen_addresses = '*'/g" $PG_CONF

# Add external access rule if it doesn't exist
if ! grep -q "host all all 0.0.0.0/0 md5" $PG_HBA_CONF; then
    echo "host all all 0.0.0.0/0 md5" | sudo tee -a $PG_HBA_CONF
fi

# Restart PostgreSQL to apply changes
echo "Restarting PostgreSQL service..."
sudo systemctl restart postgresql

echo ""
echo "===== Setup Complete ====="
echo ""
echo "Database: db"
echo "User: bill_kaplan"
echo "Password: b1ackjack!"
echo ""
echo "To verify connection, run:"
echo "psql -h localhost -U bill_kaplan -d db"
echo ""
echo "Make sure your application's config.py contains these connection details:"
echo "db_host = \"localhost\"  # or server IP if connecting remotely"
echo "db_port = 5432"
echo "db_name = \"db\""
echo "db_user = \"bill_kaplan\""
echo "db_password = \"b1ackjack!\""
